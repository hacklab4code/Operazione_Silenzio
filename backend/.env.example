# Copia questo file in .env e inserisci le chiavi (il file .env è privato: non condividerlo)
# auto = senza chiavi parte la vetrina simulata; simulata = percorso guidato anche se le chiavi ci sono; live = solo l'agente
ANIMA_MODALITA=auto

# Chiavi dei modelli
GROQ_API_KEY=
# Seconda chiave Groq: usata se la prima è esaurita
GROQ_API_KEY_2=
OPENAI_API_KEY=

# Modello OpenAI, usato dopo Groq (serve credito sull'account)
AGENTE_MODELLO_OPENAI=gpt-5.4-mini

# Modelli dell'agente: Groq in quest'ordine, poi OpenAI (se c'è la chiave), poi Ollama locale
AGENTE_MODELLI_GROQ=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Facoltativo: un'altra cartella dati (predefinita: ../dati)
# DATI_DIR=
CORS_ORIGINS=*

# Ragionamento dei modelli gpt-oss su Groq (low = più veloce ma sbaglia le trappole)
AGENTE_RAGIONAMENTO=medium

# Facoltativo: qualunque API compatibile OpenAI, usata per prima, prima di Groq
# Per Gemini: AGENTE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AGENTE_URL=
AGENTE_CHIAVE=
AGENTE_MODELLO=
